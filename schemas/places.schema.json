{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kuil09/map/blob/main/schemas/places.schema.json",
  "title": "Humphreys Field Guide canonical places",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name_en",
      "name_ko",
      "area",
      "category",
      "setting",
      "address",
      "description",
      "notes",
      "sources",
      "checked",
      "map_type",
      "coordinates",
      "coordinate_status",
      "radial_distance_km"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      },
      "name_en": {
        "type": "string",
        "minLength": 1
      },
      "name_ko": {
        "type": "string",
        "minLength": 1
      },
      "area": {
        "type": "string"
      },
      "category": {
        "type": "string",
        "enum": [
          "activities",
          "attractions",
          "camping",
          "cinema",
          "family",
          "food",
          "hobbies",
          "landmarks",
          "scenery",
          "sea",
          "shopping"
        ]
      },
      "setting": {
        "enum": [
          "indoor",
          "outdoor",
          "mixed"
        ]
      },
      "address": {
        "type": "string",
        "minLength": 1
      },
      "description": {
        "type": "object",
        "required": [
          "en",
          "ko",
          "ja",
          "zh",
          "es"
        ],
        "properties": {
          "en": {
            "type": "string"
          },
          "ko": {
            "type": "string"
          },
          "ja": {
            "type": "string"
          },
          "zh": {
            "type": "string"
          },
          "es": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "notes": {
        "type": "object",
        "required": [
          "en",
          "ko",
          "ja",
          "zh",
          "es"
        ],
        "properties": {
          "en": {
            "type": "string"
          },
          "ko": {
            "type": "string"
          },
          "ja": {
            "type": "string"
          },
          "zh": {
            "type": "string"
          },
          "es": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "sources": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "url",
            "quality",
            "audit"
          ],
          "properties": {
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            },
            "quality": {
              "type": "string"
            },
            "audit": {
              "type": "object",
              "required": [
                "checked",
                "status",
                "scope"
              ],
              "properties": {
                "checked": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "verified",
                    "unconfirmed",
                    "blocked"
                  ]
                },
                "scope": {
                  "type": "string"
                },
                "http": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "title": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "final_url": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "reason": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      },
      "checked": {
        "type": "string"
      },
      "map_type": {
        "type": "string"
      },
      "coordinates": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "required": [
              "lat",
              "lng"
            ],
            "properties": {
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "lng": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            },
            "additionalProperties": false
          }
        ]
      },
      "coordinate_status": {
        "type": "string"
      },
      "radial_distance_km": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0
      }
    },
    "additionalProperties": true
  }
}
